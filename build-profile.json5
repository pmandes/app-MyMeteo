{
  "app": {
    "products": [
      {
        "name": "default",
        "compileSdkVersion": 23,
        "compatibleSdkVersion": 20,
        "targetSdkVersion": 23,
        "runtimeOS": "OpenHarmony"
      },
      {
        "name": "watch",
        "compileSdkVersion": 23,
        "compatibleSdkVersion": 20,
        "targetSdkVersion": 23,
        "runtimeOS": "OpenHarmony"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "watch",
      "srcPath": "./watch",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "watch"
          ]
        }
      ]
    },
    {
      "name": "data",
      "srcPath": "./data",
      "targets": [{ "name": "default", "applyToProducts": ["default", "watch"] }]
    },
    {
      "name": "common",
      "srcPath": "./common",
      "targets": [{ "name": "default", "applyToProducts": ["default", "watch"] }]
    }
  ]
}
